<% content_for :title, "#{@variant.name} — The Mix" %>
<div class="detail-toolbar"><%= link_to "← Back to library", variants_path, class: "back-link" %><div class="detail-nav-actions"><%= link_to "← Previous", @previous_variant, class: "button secondary", aria: { label: @previous_variant ? "Previous variant: #{@previous_variant.name}" : nil } if @previous_variant %><%= link_to "Next →", @next_variant, class: "button secondary", aria: { label: @next_variant ? "Next variant: #{@next_variant.name}" : nil } if @next_variant %><%= link_to "Edit variant ↗", edit_variant_path(@variant), class: "button primary detail-edit-button" %></div></div>

<article class="pdf-card" aria-label="<%= @variant.name %> quick reference card">
  <div class="pdf-card-top"><span></span><span class="player-limit-number"><%= @variant.max_players.presence || "—" %></span></div>
  <div class="pdf-card-title"><span class="pdf-suit"><%= { "Draw" => "♣", "Hold'em" => "♠", "Omaha" => "♦", "Stud" => "♥" }.fetch(@variant.family, "♠") %></span><div><h2><%= @variant.name %></h2></div></div>
  <div class="pdf-card-rule"></div>
  <div class="pdf-card-badges"><span><%= { "fixed_limt" => "LIMIT", "pot_limit" => "POT LIMIT", "no_limit" => "NO LIMIT" }.fetch(@variant.betting_format, @variant.betting_structure.to_s.match?(/Fixed-Limit/i) ? "LIMIT" : "NO LIMIT") %></span><span><%= @variant.forced_bet.presence || "No forced bet specified" %></span><span class="starting-cards-badge"><%= @variant.starting_cards_down.presence || "Starting cards unspecified" %></span></div>
  <div class="pdf-sequence"><div class="sequence-track"><% sequence = @variant.source_detail.fetch("sequence", []) %><% if @variant.name == "6-Card Shodugi" %><% labels = ["6 DOWN", "SEPARATE 2 & 4 · CAP", "BET", "C C C", "BET", "BADUGI DRAW", "C C", "BET", "C", "BET"] %><% labels.each do |label| %><div class="sequence-step"><span class="sequence-event"><%= sequence_label_markup(label) %></span></div><% end %><% else %><% sequence.each do |event| %><% type = event["event_type"].to_s.downcase %><% community_cards = event["community_card_count"].to_i %><% hole_cards = event["hole_card_count"].to_i %><% label = if type == "deal" && community_cards.positive? then (["C"] * community_cards).join(" ") elsif type == "deal" && hole_cards.positive? then "#{hole_cards} DOWN" elsif type == "betting" then "BET" elsif type == "draw" then (event["event_name"].presence || "DRAW").upcase elsif type == "special" then (event["event_name"].presence || "SPECIAL").upcase else event["event_name"].presence || type.humanize end %><div class="sequence-step"><span class="sequence-event"><%= sequence_label_markup(label) %></span></div><% end %><% end %><% if sequence.empty? %><div class="sequence-empty">Sequence details haven’t been added yet.</div><% end %></div></div>
  <div class="pdf-card-columns"><div><% if @variant.split_pot != "Yes" %><p class="pdf-label">POT #1</p><% end %><% if @variant.hand_rules.exists? %><% if @variant.split_pot == "Yes" %><div class="final-hand-split"><% @variant.hand_rules.first(2).each do |rule| %><div><p class="pdf-label pot-label">POT #<%= rule.pot_number %></p><div class="final-hand-rule-row"><p class="final-hand-rule"><%= hand_rule_base_label(rule) %></p><span class="final-hand-ace"><%= ace_behavior_marker(rule) %></span></div><% if hand_rule_nuts(rule).present? %><p class="final-hand-nuts">Nuts: <%= hand_rule_nuts(rule) %></p><% end %></div><% end %></div><% else %><div class="final-hand-rule-row"><p class="final-hand-rule"><%= hand_rule_base_label(@variant.hand_rules.first) %></p><span class="final-hand-ace"><%= ace_behavior_marker(@variant.hand_rules.first) %></span></div><% if hand_rule_nuts(@variant.hand_rules.first).present? %><p class="final-hand-nuts">Nuts: <%= hand_rule_nuts(@variant.hand_rules.first) %></p><% end %><% end %><% else %><p><%= @variant.final_hand.presence || @variant.best_hand.presence || "Best poker hand" %></p><% end %></div><div><p class="pdf-label">SPECIAL MECHANICS</p><p><%= @variant.special_mechanics.presence || @variant.wild_cards.presence %></p></div></div>
  <div class="pdf-card-footer"><span>RULES REFERENCE</span><span><%= @variant.source_pages.present? ? "SOURCE PAGE #{@variant.source_pages}" : "CUSTOM VARIANT" %></span></div>
</article>

<p class="detail-caption">Quick reference card · Edit the complete rules below</p>
<% if @variant.hand_rules.exists? %><section class="hand-rules-summary"><p class="eyebrow">HAND CONSTRUCTION</p><div class="hand-rule-list"><% @variant.hand_rules.each do |rule| %><div><strong><%= @variant.hand_rules.one? ? "Best hand" : "Pot #{rule.pot_number}" %></strong><span><%= rule.notes.presence || "Best #{rule.hand_size || 5}-card hand" %></span></div><% end %></div></section><% end %>
<section class="detail-attributes"><p class="eyebrow">VARIANT ATTRIBUTES</p><table><thead><tr><th>Attribute</th><th>Value</th></tr></thead><tbody><% Variant::FIELDS.keys.sort_by(&:to_s).each do |field| %><tr><th scope="row"><%= field %></th><td><%= @variant.public_send(field).presence || "Not specified" %></td></tr><% end %></tbody></table></section>
<% if @variant.sequence_steps.exists? %><section class="detail-attributes sequence-attributes"><p class="eyebrow">SEQUENCE STEPS</p><table><thead><tr><th>Position</th><th>Action Type</th><th>Label</th><th>Quantity</th><th>Details</th><th>Source Pages</th></tr></thead><tbody><% @variant.sequence_steps.each do |step| %><tr><th scope="row"><%= step.position %></th><td><%= step.action_type %></td><td><%= step.label %></td><td><%= [step.quantity, step.quantity_unit].compact.join(" ").presence || "Not specified" %></td><td><%= step.details.presence || "Not specified" %></td><td><%= step.source_pages.presence || "Not specified" %></td></tr><% end %></tbody></table></section><% end %>
<% if @variant.source_detail.present? %>
<section class="source-section"><p class="eyebrow">WORKBOOK REFERENCE</p><h2>Original source material</h2><p>Preserved from the spreadsheet for reference. These excerpts reflect the original import, independently of edits above.</p>
<% { "sequence" => "Game sequence", "hand_rules" => "Hand rules", "model" => "Normalized variant model", "source" => "Source index", "raw_pages" => "Raw source pages" }.each do |key, title| %>
  <% data = @variant.source_detail[key]; next if data.blank? %>
  <details><summary><%= title %></summary><% (data.is_a?(Array) ? data : [data]).each do |row| %><dl class="source-row"><% row.each do |label, value| %><% next if value.blank? || %w[variant_id variant_name].include?(label) %><div><dt><%= label.humanize %></dt><dd><%= value %></dd></div><% end %></dl><% end %></details>
<% end %>
</section>
<% end %>
<section class="danger-zone"><div><h3>Delete this variant</h3><p>Permanently remove this game from the library.</p></div><%= button_to "Delete variant", @variant, method: :delete, class: "button danger", form: { data: { turbo_confirm: "Delete #{@variant.name}? This cannot be undone." } } %></section>
