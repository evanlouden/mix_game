<% content_for :title, "#{@variant.name} — The Mix" %>
<div class="detail-toolbar"><%= link_to "← Back to library", variants_path, class: "back-link" %><div class="detail-nav-actions"><span class="review-badge <%= @variant.confirmed? ? "confirmed" : "needs-review" %>"><%= @variant.confirmed? ? "CONFIRMED" : "NEEDS REVIEW" %></span><%= button_to(@variant.confirmed? ? "Mark needs review" : "Mark confirmed", @variant, method: :patch, params: { variant: { confirmed: !@variant.confirmed? } }, class: "button secondary review-toggle") %><%= link_to "Sequence steps ↓", "#sequence-steps", class: "button secondary" %><%= link_to "← Previous", @previous_variant, class: "button secondary", aria: { label: @previous_variant ? "Previous variant: #{@previous_variant.name}" : nil } if @previous_variant %><%= link_to "Next →", @next_variant, class: "button secondary", aria: { label: @next_variant ? "Next variant: #{@next_variant.name}" : nil } if @next_variant %><%= link_to "Edit variant ↗", edit_variant_path(@variant), class: "button primary detail-edit-button" %></div></div>

<article class="pdf-card" aria-label="<%= @variant.name %> quick reference card">
  <div class="pdf-card-top"><span></span><span class="player-limit-number"><%= @variant.max_players.presence || "—" %></span></div>
  <div class="pdf-card-title"><span class="pdf-suit"><%= { "Draw" => "♣", "Hold'em" => "♠", "Omaha" => "♦", "Stud" => "♥" }.fetch(@variant.family, "♠") %></span><div><h2><%= @variant.name %></h2></div></div>
  <div class="pdf-card-rule"></div>
  <div class="pdf-card-badges"><span><%= { "fixed_limt" => "LIMIT", "pot_limit" => "POT LIMIT", "no_limit" => "NO LIMIT" }.fetch(@variant.betting_format, @variant.betting_structure.to_s.match?(/Fixed-Limit/i) ? "LIMIT" : "NO LIMIT") %></span><span><%= @variant.forced_bet.presence || "No forced bet specified" %></span><span class="starting-cards-badge"><%= @variant.starting_cards_down.presence || "Starting cards unspecified" %></span></div>
  <div class="pdf-sequence"><%= render SequenceStepsComponent.new(sequence: @variant.source_detail.fetch("sequence", [])) %></div>
  <div class="pdf-card-columns"><div><% if @variant.split_pot != "Yes" %><p class="pdf-label">POT #1</p><% end %><% if @variant.hand_rules.exists? %><% if @variant.split_pot == "Yes" %><div class="final-hand-split"><% @variant.hand_rules.first(2).each do |rule| %><div><p class="pdf-label pot-label">POT #<%= rule.pot_number %></p><div class="final-hand-rule-row"><p class="final-hand-rule"><%= hand_rule_base_label(rule) %></p><span class="final-hand-ace"><%= ace_behavior_marker(rule) %></span></div><% if hand_rule_nuts(rule).present? %><p class="final-hand-nuts">Nuts: <%= hand_rule_nuts(rule) %></p><% end %></div><% end %></div><% else %><div class="final-hand-rule-row"><p class="final-hand-rule"><%= hand_rule_base_label(@variant.hand_rules.first) %></p><span class="final-hand-ace"><%= ace_behavior_marker(@variant.hand_rules.first) %></span></div><% if hand_rule_nuts(@variant.hand_rules.first).present? %><p class="final-hand-nuts">Nuts: <%= hand_rule_nuts(@variant.hand_rules.first) %></p><% end %><% end %><% else %><p><%= @variant.final_hand.presence || @variant.best_hand.presence || "Best poker hand" %></p><% end %></div><div><p class="pdf-label">SPECIAL MECHANICS</p><p><%= @variant.special_mechanics.presence || @variant.wild_cards.presence %></p></div></div>
  <div class="pdf-card-footer"><span>RULES REFERENCE</span><span><%= @variant.source_pages.present? ? "SOURCE PAGE #{@variant.source_pages}" : "CUSTOM VARIANT" %></span></div>
</article>

<p class="detail-caption">Quick reference card · Edit the complete rules below</p>
<% if @variant.sequence_steps.exists? %><section id="sequence-steps" class="detail-attributes sequence-attributes"><div class="section-heading"><p class="eyebrow">SEQUENCE STEPS</p><%= link_to "Add sequence step", new_variant_sequence_step_path(@variant), class: "button secondary" %></div><table><thead><tr><th>Position</th><th>Action Type</th><th>Card Scope</th><th>Boards</th><th>Down</th><th>Up</th><th>Min Cards</th><th>Max Cards</th><th>Edit</th></tr></thead><tbody><% @variant.sequence_steps.each do |step| %><tr><th scope="row"><%= step.position %></th><td><%= step.action_type %></td><td><%= step.card_scope %></td><td><%= step.number_of_boards %></td><td><%= step.cards_down %></td><td><%= step.cards_up %></td><td><%= step.min_cards %></td><td><%= step.max_cards %></td><td><%= link_to "Edit", edit_variant_sequence_step_path(@variant, step), class: "table-action" %></td></tr><% end %></tbody></table></section><% else %><section id="sequence-steps" class="detail-attributes sequence-attributes"><div class="section-heading"><p class="eyebrow">SEQUENCE STEPS</p><%= link_to "Add sequence step", new_variant_sequence_step_path(@variant), class: "button secondary" %></div></section><% end %>
<section class="detail-attributes"><p class="eyebrow">VARIANT ATTRIBUTES</p><table><thead><tr><th>Attribute</th><th>Value</th></tr></thead><tbody><% Variant::FIELDS.keys.sort_by(&:to_s).each do |field| %><tr><th scope="row"><%= field %></th><td><%= @variant.public_send(field).presence || "Not specified" %></td></tr><% end %></tbody></table></section>
<section class="danger-zone"><div><h3>Delete this variant</h3><p>Permanently remove this game from the library.</p></div><%= button_to "Delete variant", @variant, method: :delete, class: "button danger", form: { data: { turbo_confirm: "Delete #{@variant.name}? This cannot be undone." } } %></section>
