<% content_for :title, "Edit #{@variant.name} — The Mix" %>
<%= link_to "← Back to variant", @variant, class: "back-link" %>
<div class="page-heading"><p class="eyebrow">REFINE THE RULES</p><h1>Edit <%= @variant.name %></h1><p>Keep your library ready for the next game night.</p></div>
<%= render "form", variant: @variant %>

<section class="danger-zone edit-danger-zone">
  <div>
    <h3>Delete this variant</h3>
    <p>Permanently remove this game from the library.</p>
  </div>
  <%= button_to "Delete variant", @variant, method: :delete, class: "button danger", form: { data: { turbo_confirm: "Delete #{@variant.name}? This cannot be undone." } } %>
</section>
