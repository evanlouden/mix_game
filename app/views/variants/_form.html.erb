<%= form_with model: variant, class: "variant-form" do |form| %>
  <% if variant.errors.any? %><div class="form-errors" role="alert"><strong>Please check these fields:</strong><ul><% variant.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="form-actions form-actions-top"><span>* Required fields. Leave unknown rules blank.</span><div><%= link_to "Cancel", variant.persisted? ? variant_path(variant) : variants_path, class: "button secondary" %><%= form.submit variant.persisted? ? "Save changes" : "Create variant", class: "button primary" %></div></div>
  <% if variant.persisted? && variant.hand_rules.exists? %>
    <section class="form-section hand-rules-editor"><div class="form-section-heading"><span class="section-number">HR</span><h2>Hand ranking rules</h2></div>
      <p class="form-help">Choose the ranking rule and Ace behavior for each pot.</p>
      <%= form.fields_for :hand_rules do |rule_form| %>
        <div class="hand-rule-edit-row"><div class="hand-rule-main"><strong>Pot #<%= rule_form.object.pot_number %></strong><%= rule_form.hidden_field :id %><%= rule_form.select :rule, HandRule::RANKING_RULES.map { |value| [HandRule::RANKING_LABELS.fetch(value), value] }, {}, aria: { label: "Pot #{rule_form.object.pot_number} ranking rule" } %><%= rule_form.select :ace_behavior, HandRule::ACE_BEHAVIORS.map { |value| [value.humanize, value] }, { include_blank: "Ace behavior" }, aria: { label: "Pot #{rule_form.object.pot_number} Ace behavior" } %></div><%= rule_form.text_field :qualifier, placeholder: "Qualifier (e.g. 8 or better)", aria: { label: "Pot #{rule_form.object.pot_number} qualifier" } %></div>
      <% end %>
    </section>
  <% end %>
  <section class="form-section review-section"><div class="form-section-heading"><span class="section-number">✓</span><h2>Review</h2></div><div class="review-field"><%= form.check_box :confirmed %><%= form.label :confirmed, "Confirmed" %><small class="form-help">Mark this when the variant’s rules and sequence have been reviewed.</small></div></section>
  <% Variant::GROUPS.each_with_index do |(title, fields), index| %>
    <section class="form-section"><div class="form-section-heading"><span class="section-number">0<%= index + 1 %></span><h2><%= title %></h2></div><div class="form-grid">
      <% fields.each do |field| %>
        <div class="field <%= 'wide' if Variant::LONG_FIELDS.include?(field) || field == :name || field.in?(%i[pot_1_hand_rule pot_2_hand_rule]) %>">
          <%= form.label field, "#{Variant::FIELDS[field]}#{' *' if %i[name family].include?(field)}" %>
          <% if field == :split_pot %>
            <%= form.select field, ["Yes", "No"], include_blank: "Not specified" %>
          <% elsif field == :betting_format %>
            <%= form.select field, Variant::BETTING_FORMATS.map { |value| [Variant::BETTING_FORMAT_LABELS.fetch(value), value] }, { include_blank: "Select an option" } %>
          <% elsif field == :family %>
            <% options = field == :family ? Variant::FAMILIES : Variant::GAME_TYPES %>
            <%= form.select field, options | [variant.public_send(field)].compact, { include_blank: "Select an option" }, required: true %>
          <% elsif Variant::LONG_FIELDS.include?(field) %>
            <%= form.text_area field, rows: 3 %>
          <% elsif %i[max_players starting_cards_down starting_cards_up].include?(field) %>
            <%= form.number_field field, min: field == :max_players ? 1 : 0, step: 1 %>
          <% else %>
            <%= form.text_field field, required: field == :name %>
          <% end %>
        </div>
      <% end %>
    </div></section>
  <% end %>
<% end %>
