<%= form_with model: variant, class: "variant-form" do |form| %>
  <% if variant.errors.any? %><div class="form-errors" role="alert"><strong>Please check these fields:</strong><ul><% variant.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
  <div class="form-actions form-actions-top"><span>* Required fields. Leave unknown rules blank.</span><div><%= link_to "Cancel", variant.persisted? ? variant_path(variant) : variants_path, class: "button secondary" %><%= form.submit variant.persisted? ? "Save changes" : "Create variant", class: "button primary" %></div></div>
  <section class="form-section">
  <div class="form-grid">
    <div class="field wide"><%= form.label :name, "Name" %><%= form.text_field :name, required: true %></div>
    <div class="field wide betting-options-field"><%= form.label :no_limit, "Betting options" %><div class="betting-options-row"><div class="boolean-field"><%= form.check_box :no_limit %><%= form.label :no_limit, "No Limit" %></div><div class="boolean-field"><%= form.check_box :pot_limit %><%= form.label :pot_limit, "Pot Limit" %></div><div class="boolean-field"><%= form.check_box :fixed_limit %><%= form.label :fixed_limit, "Limit" %></div></div></div>
    <div class="field wide"><div class="boolean-field"><%= form.check_box :bomb_pot %><%= form.label :bomb_pot, "Bomb Pot" %></div></div>
    <div class="field"><%= form.label :pot_1_hand_rule, "Pot 1 Hand Rule" %><%= form.select :pot_1_hand_rule, Variant::HAND_RULES.map { |value| [Variant::HAND_RULE_LABELS.fetch(value), value] }, { include_blank: "Select a hand rule" } %></div>
    <div class="field"><%= form.label :pot_1_qualifier, "Pot 1 Qualifier" %><%= form.select :pot_1_qualifier, Variant::POT_QUALIFIERS.sort_by { |_, label| label }.map { |value, label| [label, value] }, { include_blank: "No qualifier" } %></div>
    <div class="field"><%= form.label :pot_2_hand_rule, "Pot 2 Hand Rule" %><%= form.select :pot_2_hand_rule, Variant::HAND_RULES.map { |value| [Variant::HAND_RULE_LABELS.fetch(value), value] }, { include_blank: "Select a hand rule" } %></div>
    <div class="field"><%= form.label :pot_2_qualifier, "Pot 2 Qualifier" %><%= form.select :pot_2_qualifier, Variant::POT_QUALIFIERS.sort_by { |_, label| label }.map { |value, label| [label, value] }, { include_blank: "No qualifier" } %></div>
    <div class="field wide"><%= form.label :special_mechanics, "Special Mechanics" %><%= form.text_area :special_mechanics, rows: 3 %></div>
  <% Variant::GROUPS.each_value do |fields| %>
      <% fields.each do |field| %>
        <div class="field <%= 'wide' if Variant::LONG_FIELDS.include?(field) || field == :name || field.in?(%i[pot_1_hand_rule pot_2_hand_rule]) %>">
          <%= form.label field, "#{Variant::FIELDS[field]}#{' *' if %i[name family].include?(field)}" %>
          <% if field == :forced_bet %>
            <%= form.select field, Variant::FORCED_BETS, include_blank: "Not specified" %>
          <% elsif field == :bring_in %>
            <%= form.select field, Variant::BRING_INS.map { |value, label| [label, value] }, include_blank: "Not specified" %>
          <% elsif field.in?(%i[no_limit pot_limit fixed_limit]) %>
            <div class="boolean-field"><%= form.check_box field %><%= form.label field, Variant::BETTING_OPTION_LABELS.fetch(field) %></div>
          <% elsif field == :family %>
            <% options = field == :family ? Variant::FAMILIES : Variant::GAME_TYPES %>
            <%= form.select field, options | [variant.public_send(field)].compact, { include_blank: "Select an option" }, required: true %>
          <% elsif Variant::LONG_FIELDS.include?(field) %>
            <%= form.text_area field, rows: 3 %>
          <% elsif field == :max_players %>
            <%= form.number_field field, min: field == :max_players ? 1 : 0, step: 1 %>
          <% else %>
            <%= form.text_field field, required: field == :name %>
          <% end %>
        </div>
      <% end %>
  <% end %>
  </div>
  </section>
<% end %>
