<section class="grid min-h-[365px] items-center gap-8 py-10 sm:grid-cols-[1.3fr_1fr]">
  <div>
    <p class="mb-4 flex items-center gap-2 text-[10px] font-bold tracking-[0.22em] text-ink"><span class="inline-block h-1.5 w-1.5 rounded-full bg-[#779b63]"></span> THE POKER VARIANT LIBRARY</p>
    <h1 class="mb-4 font-serif text-4xl leading-tight font-medium tracking-tight text-ink sm:text-[51px]">Find your next <em class="text-[#608364] italic">game.</em></h1>
    <p class="mb-6 text-sm leading-loose text-muted">From the classics to the wonderfully unfamiliar.<br>Explore the rules, learn the mechanics, and keep your mix fresh.</p>
    <div class="flex gap-2">
    </div>
  </div>
  <%= render HeroCardsComponent.new %>
</section>
<section class="stats" aria-label="Library statistics">
  <div><span class="stat-icon">♠</span><strong><%= @total %></strong><span>poker variants</span></div>
  <div><span class="stat-icon">▦</span><strong><%= @family_counts.size %></strong><span>game families</span></div>
  <div><span class="stat-icon">◐</span><strong><%= @split_count %></strong><span>split-pot games</span></div>
  <div class="stat-note"><span class="status-dot"></span> Your next favorite is in here.</div>
</section>
<section class="library">
  <div class="section-heading"><h2>The library <span><%= @total %></span></h2><p>A different deal for every table.</p></div>
  <%= form_with url: variants_path, method: :get, class: "filters" do |form| %>
    <div class="search-field"><span aria-hidden="true">⌕</span><%= form.search_field :q, value: params[:q], placeholder: "Search names, rules, or mechanics…", aria: { label: "Search variants" } %></div>
    <%= form.select :family, Variant::FAMILIES | @family_counts.keys.compact.sort, { include_blank: "All families", selected: params[:family] }, aria: { label: "Game family" } %>
    <%= form.select :split_pot, [["Split pot", "Yes"], ["Single pot", "No"]], { include_blank: "All pot types", selected: params[:split_pot] }, aria: { label: "Pot type" } %>
    <%= form.select :betting_format, [["Pot limit", "pot_limit"], ["No limit", "no_limit"], ["Limit", "fixed_limit"]], { include_blank: "All betting formats", selected: params[:betting_format] }, aria: { label: "Betting format" } %>
    <%= form.select :bomb_pot, [["Bomb pots", "Yes"], ["Non-bomb pots", "No"]], { include_blank: "All bomb pot types", selected: params[:bomb_pot] }, aria: { label: "Bomb pot type" } %>
    <%= form.select :players, @player_options.map { |players| ["#{players} players", players] }, { include_blank: "All player counts", selected: params[:players] }, aria: { label: "Number of players" } %>
    <div class="filter-actions"><%= form.submit "Filter", class: "button primary" %><%= link_to "Random", random_variant_path(request.query_parameters.except("page")), class: "button random-filter-button" %></div>
  <% end %>
  <div class="results-heading"><span><%= @count %> <%= "variant".pluralize(@count) %><%= " matching your filters" if params.values_at(:q, :family, :split_pot, :betting_format, :bomb_pot, :players).any?(&:present?) %></span><%= link_to "Clear filters", variants_path if params.values_at(:q, :family, :split_pot, :betting_format, :bomb_pot, :players).any?(&:present?) %><span class="sort-note">NAME A–Z</span></div>
  <% if @variants.empty? %>
    <div class="empty-state"><span>♧</span><h2>No variants found</h2><p>Try a broader search or add a game of your own.</p><%= link_to "Reset filters", variants_path, class: "button secondary" %><%= link_to "Add variant", new_variant_path, class: "button primary" if current_user&.admin? %></div>
  <% else %>
    <div class="variant-grid">
      <% @variants.each do |variant| %>
        <%= link_to variant, class: "variant-card" do %>
          <div class="library-row"><h3><%= variant.name %></h3><div class="library-meta"><span class="format-badge"><%= variant.betting_format_display.upcase %></span><span class="library-players"><%= variant.max_players.presence || "—" %></span></div></div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
