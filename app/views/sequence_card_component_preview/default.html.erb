<div class="sequence-card-preview">
  <% { "Down" => [:down, 3], "Community" => [:community, 1], "Individual up" => [:up, 1], "Discard" => [:discard, 1], "Draw" => [:draw, 5] }.each do |title, (state, count)| %>
    <section><h3><%= title %></h3><div class="sequence-card-preview-stage"><%= render SequenceCardComponent.new(state: state, count: count) %></div></section>
  <% end %>
  <section><h3>Poker chip</h3><div class="sequence-card-preview-stage poker-chip-single-preview"><%= render PokerChipComponent.new %></div></section>
  <section><h3>Betting round</h3><div class="sequence-card-preview-stage"><%= render PokerChipComponent.new %></div></section>
</div>
