<svg class="poker-chip-svg" viewBox="0 0 52 52" role="img" aria-label="Betting round chips" xmlns="http://www.w3.org/2000/svg">
  <title>Betting round chips</title>

  <% [count, 3].min.downto(1) do |chip_number| %>
    <% offset = (chip_number - 1) * 4 %>
    <% rotation = { 1 => 0, 2 => 11, 3 => -8 }.fetch(chip_number) %>
    <g transform="translate(0 <%= offset %>) rotate(<%= rotation %> 26 26)">
    <circle cx="26" cy="26" r="24" class="poker-chip-svg__base" />
    <g class="poker-chip-svg__inserts">
      <rect x="19.7" y="1.6" width="11.6" height="7.6" rx="1" />
      <rect x="19.7" y="1.6" width="11.6" height="7.6" rx="1" transform="rotate(90 26 26)" />
      <rect x="19.7" y="1.6" width="11.6" height="7.6" rx="1" transform="rotate(180 26 26)" />
      <rect x="19.7" y="1.6" width="11.6" height="7.6" rx="1" transform="rotate(270 26 26)" />
    </g>
    <circle cx="26" cy="26" r="15.8" class="poker-chip-svg__center" />
    <% if chip_number == 1 %>
      <text x="26.5" y="27.5" class="poker-chip-svg__value">$</text>
    <% end %>
    <circle cx="26" cy="26" r="17.2" class="poker-chip-svg__inner-border" />
    </g>
  <% end %>
</svg>
